# Dockerfile.backend
# 兼容经典 docker build：所有用于 FROM 的 ARG 必须写在第一个 FROM 之前
ARG GO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/golang:1.26.2-alpine
ARG ALPINE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/alpine:3.19

FROM ${GO_IMAGE} AS builder

RUN apk add --no-cache tzdata ca-certificates git

WORKDIR /app

ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=off \
    CGO_ENABLED=0 \
    GOOS=linux

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /yunshu ./main.go

FROM ${ALPINE_IMAGE}

# 巡检 PDF：wkhtmltopdf 离线包 > Alpine 3.14 apk > 跳过（Go 结构化 PDF 降级）
# 不依赖 Docker Hub 拉取 surnet 镜像，避免内网构建超时
RUN apk add --no-cache \
    tzdata ca-certificates \
    libstdc++ libx11 libxrender libxext libssl3 \
    fontconfig freetype \
    ttf-freefont font-wqy-zenhei
COPY deploy/wkhtmltopdf/ /tmp/wkhtmltopdf-bundle/
COPY deploy/docker/install-wkhtmltopdf.sh /tmp/install-wkhtmltopdf.sh
RUN chmod +x /tmp/install-wkhtmltopdf.sh \
    && /tmp/install-wkhtmltopdf.sh /tmp/wkhtmltopdf-bundle \
    && rm -rf /tmp/wkhtmltopdf-bundle /tmp/install-wkhtmltopdf.sh

COPY --from=builder /yunshu /app/yunshu
COPY configs/ /app/configs/
COPY data/ai/ /app/data/ai/
COPY deploy/loggie/binary/loggie /app/deploy/loggie/binary/loggie
COPY deploy/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

WORKDIR /app
ENV YUNSHU_AI_DATA_DIR=/app/data/ai
EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["server"]
