# Dockerfile.backend
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/golang:1.25-alpine AS builder

# 安装时区数据和ca证书
RUN apk add --no-cache tzdata ca-certificates

WORKDIR /app
COPY go.mod go.sum ./

# 国内 Go 代理（解决你之前下载超时）
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off

RUN go mod download

COPY . .

# 编译二进制
RUN CGO_ENABLED=0 GOOS=linux GOMAXPROCS=1 go build -o /yunshu ./main.go

# 运行镜像 - 使用 alpine 替代 scratch，包含基础工具和时区数据
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/alpine:3.19

# 时区/证书；Chromium 用于巡检报告 HTML→PDF（含样式）；Noto CJK 保证中文渲染
RUN apk add --no-cache \
    tzdata ca-certificates \
    chromium nss freetype harfbuzz ttf-freefont font-noto-cjk \
 && ln -sf /usr/bin/chromium /usr/bin/chromium-browser 2>/dev/null || true

ENV YUNSHU_CHROME_PATH=/usr/bin/chromium
ENV CHROME_PATH=/usr/bin/chromium

COPY --from=builder /yunshu /app/yunshu
COPY configs/ /app/configs/
# AI 能力中心种子（Prompt/KB/案例/SOP/脚本工具/Eval）；运行时 CWD=/app
COPY data/ai/ /app/data/ai/
# 离线 Loggie 安装包（linux/amd64 ELF），安装 Agent 时由平台 SFTP 上传
COPY deploy/loggie/binary/loggie /app/deploy/loggie/binary/loggie
COPY deploy/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

WORKDIR /app
ENV YUNSHU_AI_DATA_DIR=/app/data/ai
EXPOSE 8080

# 启动前可选执行 seed（RUN_SEED=1），再 exec server
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["server"]
