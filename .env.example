# Yunshu 运维平台 - 环境变量配置
# 复制此文件为 .env 并修改密码

# MySQL 配置（容器 backend 连宿主机 MySQL 时用环境变量覆盖 config.yaml）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YourStrongPasswordHere!
MYSQL_ROOT_PASSWORD=YourStrongPasswordHere!
MYSQL_DB_NAME=yunshu

# Redis 配置
REDIS_PASSWORD=YourRedisPasswordHere!

# JWT 密钥（用于 token 签名）
JWT_SECRET=YourLongRandomJWTSecretKeyHere2026

# 加密密钥（32字节 base64 编码）
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# 应用日志（覆盖 configs/config.yaml 中 log.*，见 docs/logging.md）
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=both
LOG_FILE_PATH=./logs
LOG_MAX_SIZE_MB=100
LOG_MAX_AGE_DAYS=30
LOG_MAX_BACKUPS=10
LOG_COMPRESS=true

RUN_SEED=1