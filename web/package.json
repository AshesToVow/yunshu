{
  "name": "yunshu-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/services/**/*.{ts,tsx}\" \"src/pages/login-page.tsx\" \"src/stores/**/*.{ts,tsx}\" \"src/hooks/use-admin-theme-mode.ts\" \"src/app/app.tsx\"",
    "lint:all": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/services/**/*.{ts,tsx}\" \"src/pages/login-page.tsx\" \"src/stores/**/*.{ts,tsx}\" \"src/hooks/use-admin-theme-mode.ts\" \"src/app/app.tsx\"",
    "format:all": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/services/**/*.{ts,tsx}\" \"src/pages/login-page.tsx\" \"src/stores/**/*.{ts,tsx}\" \"src/hooks/use-admin-theme-mode.ts\" \"src/app/app.tsx\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.27.1",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18next": "^26.2.0",
    "jspdf": "^2.5.2",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.30.1",
    "yaml": "^2.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^5.4.19",
    "vitest": "^3.0.8"
  }
}
